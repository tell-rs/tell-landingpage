# Stripe configuration for the landing-page checkout (src/checkout.ts).
# Copy to .env and fill with real values. Test-mode keys/prices first.

# Secret API key (sk_test_... in test mode, sk_live_... in production).
STRIPE_SECRET_KEY=

# Sellable checkout tiers (CHECKOUT_TIERS = pro | pro-yearly).
# DECIDED AMOUNTS (2026-07-25): create these prices in the Stripe dashboard
# and paste the ids here. They must also appear in tell-platform's
# [[stripe.prices]] table (same ids) so the webhook applies the license.
#
# Cloud Pro — $99/month
STRIPE_PRICE_PRO_MONTHLY=
# Cloud Pro — $1,008/year ($84/mo, the -15% annual rate)
STRIPE_PRICE_PRO_YEARLY=

# Business ($349/mo, $3,564/yr) is contact-sales — no landing checkout env
# vars; sales sends a checkout link for the price ids configured in
# tell-platform. Metered overage prices ($0.10/1K free, $0.03/1K pro) also
# live only in tell-platform's [stripe.metered].
